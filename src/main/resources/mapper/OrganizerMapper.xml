<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.OrganizerMapper">
	<select id="getOrganizerInfoByUserId"
		resultType="com.example.demo.entity.Organizer">
		SELECT * FROM organizer_master
		WHERE userId = #{userId}
	</select>
</mapper>
